CameraSonyConfig:
    camera_index: 1
    width: 1920
    height: 1080
    fps: 30
    rtsp_url: rtsp://localhost:8554/mystream
    snapshot_host: 0.0.0.0
    snapshot_port: 8001
    ffmpeg_path: D:\Driver\ffmpeg-2026-05-06-git-f2e5eff3ff-essentials_build\bin\ffmpeg.exe
    ffmpeg_cmd:
        - '{ffmpeg_path}'
        - -y
        - -f
        - rawvideo
        - -vcodec
        - rawvideo
        - -pix_fmt
        - bgr24
        - -s
        - '{actual_width}x{actual_height}'
        - -r
        - '{fps}'
        - -i
        - '-'
        - -c:v
        - libx264
        - -preset
        - veryfast
        - -tune
        - zerolatency
        - -crf
        - '23'
        - -g
        - '{fps}{fps}'
        - -profile:v
        - high
        - -pix_fmt
        - yuv420p
        - -pkt_size
        - '1200'
        - -f
        - rtsp
        - -rtsp_transport
        - tcp
        - '{rtsp_url}'
